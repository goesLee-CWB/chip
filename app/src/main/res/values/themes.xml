<resources>
    <!-- Tema principal do App (Sem ActionBar) -->
    <style name="Theme.LixaTacoApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/status_bar_bg</item>
        <item name="android:navigationBarColor">@color/status_bar_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Tema do Splash Screen Nativo -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.LixaTacoApp</item>
    </style>
</resources>
